# Copy to .env locally. Never commit real keys.

# Student simulation provider currently uses OpenAI-compatible chat client in Phase 2.
OPENAI_API_KEY=your_openai_key_here
OPENAI_SIMULATION_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE_STUDENT=0.7

# Evaluator provider config for Phase 3/4.
# Supported: fallback, openai, anthropic, gemini, openai_compatible
EVALUATOR_PROVIDER=fallback
EVALUATOR_MODEL=deterministic-fallback
EVALUATOR_API_KEY=
EVALUATOR_BASE_URL=
EVALUATOR_TEMPERATURE=0.2

# Optional condition-specific overrides.
BASELINE_EVALUATOR_PROVIDER=fallback
BASELINE_EVALUATOR_MODEL=deterministic-fallback
BASELINE_EVALUATOR_API_KEY=
TIL_EVALUATOR_PROVIDER=fallback
TIL_EVALUATOR_MODEL=deterministic-fallback
TIL_EVALUATOR_API_KEY=

# Provider-specific keys if you do not use EVALUATOR_API_KEY.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=

# Gemini example:
# EVALUATOR_PROVIDER=gemini
# EVALUATOR_MODEL=gemini-2.5-flash
# EVALUATOR_API_KEY=your_gemini_key
# GEMINI_FALLBACK_MODELS=gemini-flash-latest

MAX_TURNS_PER_SESSION=12
THESIS_PROJECT_ROOT=D:/Mythesis(Honours)/thesis-project
EXPORT_ROOT=D:/Mythesis(Honours)/thesis-project/results
